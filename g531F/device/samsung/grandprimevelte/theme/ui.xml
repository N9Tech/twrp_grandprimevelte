/** Génération des PNG d'angles arrondis (rayon 16 px) — section « Assets ». */
export const ASSET_SCRIPT = `# python3 -m pip install pillow
from PIL import Image, ImageDraw

ACCENT  = (255, 122, 24, 255)   # #FF7A18 — même valeur que accent_color
CARD    = (23, 26, 30, 255)     # #171A1E
RULE    = (34, 38, 44, 255)     # #22262C
INK     = (230, 232, 235, 255)  # #E6E8EB
DARK    = (11, 12, 14, 255)     # #0B0C0E
R = 16                          # rayon 16 dp = 16 px en mdpi (540x960)

def plate(name, w, h, radius, fill, outline=None, width=2):
    im = Image.new("RGBA", (w, h), (0, 0, 0, 0))
    d = ImageDraw.Draw(im)
    d.rounded_rectangle([0, 0, w - 1, h - 1], radius=radius,
                        fill=fill, outline=outline, width=width)
    im.save("images/" + name + ".png")

# boutons demi-largeur (2 colonnes)
plate("btn_half",         234, 92, R, CARD, RULE)
plate("btn_half_primary", 234, 92, R, ACCENT)
plate("btn_half_ghost",   234, 92, R, None, RULE)
# boutons pleine largeur
plate("btn_full",         492, 92, R, CARD, RULE)
plate("btn_full_primary", 492, 92, R, ACCENT)
plate("btn_full_ghost",   492, 92, R, None, RULE)
# barre de progression + cases a cocher
plate("progress_empty",   492,  8, 4, RULE)
plate("progress_fill",    492,  8, 4, ACCENT)
plate("checkbox_false",    36, 36, 10, None, (58, 64, 72, 255))
plate("checkbox_true",     36, 36, 10, ACCENT)

# icônes dossier / fichier du selecteur de fichiers
def folder(name):
    im = Image.new("RGBA", (36, 36), (0, 0, 0, 0))
    d = ImageDraw.Draw(im)
    d.rounded_rectangle([2, 10, 34, 33], radius=4, fill=ACCENT)
    d.rounded_rectangle([2, 5, 18, 14], radius=4, fill=ACCENT)
    im.save("images/" + name + ".png")

def fileicon(name):
    im = Image.new("RGBA", (36, 36), (0, 0, 0, 0))
    d = ImageDraw.Draw(im)
    d.rounded_rectangle([7, 3, 29, 33], radius=4, outline=INK, width=2)
    d.line([12, 12, 24, 12], fill=INK, width=2)
    d.line([12, 18, 24, 18], fill=INK, width=2)
    d.line([12, 24, 20, 24], fill=INK, width=2)
    im.save("images/" + name + ".png")

folder("folder"); fileicon("file")
print("12 PNG écrits dans images/")
`;


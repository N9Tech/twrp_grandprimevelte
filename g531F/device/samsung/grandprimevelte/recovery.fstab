# Samsung Galaxy Grand Prime VE (SM-G531F / grandprimevelte)
# SoC: Marvell Armada PXA1908 - Kernel 3.10
# Factory eMMC mount point mapping: /dev/block/platform/soc.2/by-name/

# Internal eMMC factory partitions
/efs                    emmc    /dev/block/platform/soc.2/by-name/EFS      flags=backup=1;display="EFS"
/boot                   emmc    /dev/block/platform/soc.2/by-name/KERNEL   flags=backup=1;display="Boot (Kernel)"
/recovery               emmc    /dev/block/platform/soc.2/by-name/RECOVERY flags=backup=1;display="Recovery"
/cache                  ext4    /dev/block/platform/soc.2/by-name/CACHE    flags=backup=1;display="Cache"
/system                 ext4    /dev/block/platform/soc.2/by-name/SYSTEM   flags=backup=1;display="System"
/system_image           emmc    /dev/block/platform/soc.2/by-name/SYSTEM   flags=backup=1;flashimg=1;display="System Image"
/data                   ext4    /dev/block/platform/soc.2/by-name/USER     flags=encryptable=footer;length=-16384
/preload                ext4    /dev/block/platform/soc.2/by-name/HIDDEN   flags=backup=1;display="Preload / Hidden";wipeingui
/nvm                    ext4    /dev/block/platform/soc.2/by-name/NVM      flags=backup=1;display="NVM (Baseband)"
/radio                  emmc    /dev/block/platform/soc.2/by-name/MODEM    flags=backup=1;display="Modem / Radio"

# Removable & OTG external storage
/external_sd            vfat    /dev/block/mmcblk1p1   /dev/block/mmcblk1  flags=display="Micro SDcard";storage;wipeingui;removable
/usb-otg                vfat    /dev/block/sda1        /dev/block/sda      flags=display="USB-OTG";storage;wipeingui;removable